# ── Secrets ───────────────────────────────────────────────────────────────────
# Required. The backend and worker refuse to start while SECRET_KEY,
# ZENTINELLE_BOOTSTRAP_SECRET or ZENTINELLE_SECRET_KEY (below) is empty, a
# placeholder or shorter than 32 characters. Generate all three with:
#   docker compose run --rm --no-deps backend python manage.py generate_secrets
# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://zentinelle:zentinelle@localhost:5432/zentinelle
POSTGRES_USER=zentinelle
POSTGRES_PASSWORD=zentinelle

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# open           — No login required, everyone is admin (internal/dev, behind VPN)
# local          — Built-in username/password with session cookies
# sso            — OIDC via external provider (Google, Okta, Cognito, etc.)
# standalone     — Alias for "local" (backward compat)
AUTH_MODE=local

# Reverse proxies in front of the backend that append to X-Forwarded-For
# (compose sets 1 for its nginx; an ALB to the task is 1, ALB plus nginx 2).
# 0 ignores the header. Login throttles key on the client address it gives.
# NUM_PROXIES=0

# Hosts an agent endpoint's config.hub_identity.api_url may name although
# they resolve to a private address (an in-cluster JupyterHub). Others must
# resolve to public addresses only.
# HUB_IDENTITY_ALLOWED_HOSTS=hub.internal

# Portal sessions end after this many seconds without a request (default
# 1800); a session never outlives a week however active.
# SESSION_IDLE_TIMEOUT_SECONDS=1800

# Django admin is a second password login without the portal's throttling;
# off unless set. Enable only on a private network.
# ENABLE_DJANGO_ADMIN=false

# Bootstrap secret for agent registration tokens (standalone mode).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Tokens are issued as: bt_<tenant_id>_<HMAC-SHA256(secret, tenant_id)>
ZENTINELLE_BOOTSTRAP_SECRET=

# Required if AUTH_MODE=client_cove (see calliope.md — do not commit those values here)
# CALLIOPE_INTERNAL_API_URL=https://app.calliope.ai
# CALLIOPE_INTERNAL_API_KEY=
# CALLIOPE_TENANT_CACHE_TTL=300

# ── Encryption ────────────────────────────────────────────────────────────────
# Fernet key for secrets store encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZENTINELLE_SECRET_KEY=

# Default durable capture excludes prompt/response bodies. Choose redacted or full explicitly.
CONTENT_CAPTURE_MODE=metadata
LOG_INTERACTIONS=false
FAIL_OPEN=false

# ── Gateway provider keys ─────────────────────────────────────────────────────
# The gateway reads each tenant's stored provider key (Settings > LLM providers)
# with its own registered credential. In compose there is nothing to set: the
# backend registers a gateway named `local` for this install's tenant and writes
# its credential into the gateway_credential volume both containers mount. To
# use a credential you registered yourself (manage.py gateway_credential), put
# it here instead; it wins over the file.
ZENTINELLE_GATEWAY_CREDENTIAL=
# Deprecated, to be removed: let the gateway use its own PROVIDER_KEY_<NAME>
# (or OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_API_KEY) for a tenant with no
# stored key. Single-tenant only. Store keys per tenant in Zentinelle instead.
ALLOW_ENV_PROVIDER_KEYS=false
# Production only: public DNS hostname used for HTTPS
# ZENTINELLE_DOMAIN=zentinelle.example.com

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api/zentinelle/v1
NEXT_PUBLIC_GQL_URL=/gql/zentinelle

# ── Email (optional) ──────────────────────────────────────────────────────────
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@zentinelle.ai

# ── Temporal (background jobs and schedules) ─────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=zentinelle
TEMPORAL_TASK_QUEUE=zentinelle

# ── CSRF ──────────────────────────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=http://localhost:3002,http://localhost:8080

# ── ClickHouse (optional — for high-volume analytics) ────────────────────────
# Leave unset for standalone. Enable with: docker compose --profile analytics up
# CLICKHOUSE_URL=clickhouse://default:@localhost:8123/default

# --- Local host port bindings -------------------------------------------------
# Only affect what the compose stack publishes on your machine; containers
# always reach each other on the standard ports over the compose network.
# Postgres and Redis default off 5432/6379 because a dev machine usually
# already has something bound there, and the collision stops the stack booting.
NGINX_PORT=8080
GATEWAY_PORT_HOST=8742
POSTGRES_PORT_HOST=55432
REDIS_PORT_HOST=56379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
